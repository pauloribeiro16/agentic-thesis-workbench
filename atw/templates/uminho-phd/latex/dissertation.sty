%-- Font: NewsGotT, the official UMinho typeface (RT-80/2026). The font files are not redistributed here:
%   copy NewsGotT.ttf, NewsGotTBold.ttf and NewsGotTLight.ttf (from the UMinho Academic Portal) into fonts/.
%   Without them the template falls back to TeX Gyre Heros so it still compiles.
\IfFontExistsTF{fonts/NewsGotT.ttf}{
\setmainfont[
Path=fonts/,
BoldFont=NewsGotTBold.ttf,
ItalicFont=NewsGotT.ttf,
ItalicFeatures={FakeSlant=0.25},
BoldItalicFont=NewsGotTBold.ttf,
BoldItalicFeatures={FakeSlant=0.25},
]{NewsGotT.ttf}
\newfontfamily\NewsGotTLight[Path=fonts/]{NewsGotTLight.ttf}
}{
\PackageWarning{dissertation}{NewsGotT not found in fonts/; using TeX Gyre Heros}
\setmainfont{texgyreheros}[Extension=.otf, UprightFont=*-regular, BoldFont=*-bold,
  ItalicFont=*-italic, BoldItalicFont=*-bolditalic]
\newfontfamily\NewsGotTLight{texgyreheros}[Extension=.otf, UprightFont=*-regular]
}

